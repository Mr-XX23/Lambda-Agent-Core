<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>ai.lambda</groupId>
    <artifactId>lambda-agent-core-java</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>lambda-ai</module>
        <module>lambda-agent-core</module>
        <module>lambda-agent-mcp</module>
        <module>lambda-agent-spring-boot-starter</module>
        <module>examples/simple-chat-only</module>
        <module>examples/simple-chat-with-tools</module>
        <module>examples/simple-chat-with-JSONL-file-based-session-storage</module>
        <module>examples/todo-agent</module>
        <module>examples/simple-history-truncation</module>
        <module>examples/simple-streaming-chat</module>
        <module>examples/skills-agent</module>
        <module>examples/multi-agent</module>
        <module>examples/mcp-agent</module>
        <module>examples/structured-output</module>
        <module>examples/multimodal-agent</module>
        <module>examples/software-delivery-agent</module>
        <module>examples/database-sessions</module>
    </modules>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>25</java.version>
        <junit.version>5.11.4</junit.version>
        <mcp.version>2.0.1</mcp.version>
        <anthropic.version>2.66.0</anthropic.version>
        <openai.version>4.73.0</openai.version>
        <google-genai.version>1.73.0</google-genai.version>
        <!-- The newest Jackson any of the official SDKs needs; the SDK modules all declare it, so every
             combination of providers resolves to this one version instead of an older one. -->
        <jackson.version>2.19.4</jackson.version>
        <jacoco.version>0.8.14</jacoco.version>
        <!-- Lowest share of lines the tests must run, per module. The library modules raise it. -->
        <coverage.minimum>0.00</coverage.minimum>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>ai.lambda</groupId>
                <artifactId>lambda-ai-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.lambda</groupId>
                <artifactId>lambda-agent-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.lambda</groupId>
                <artifactId>lambda-agent-mcp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.lambda</groupId>
                <artifactId>lambda-ai-anthropic</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.lambda</groupId>
                <artifactId>lambda-ai-gemini</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.lambda</groupId>
                <artifactId>lambda-ai-openai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.lambda</groupId>
                <artifactId>lambda-ai-others</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Measures test coverage: report in target/site/jacoco, and the build fails below coverage.minimum. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>coverage-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>coverage-report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>coverage-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>api-compatibility</id>
            <activation>
                <property><name>compatibilityBaseline</name></property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <version>0.23.1</version>
                        <configuration>
                            <oldVersion>${compatibilityBaseline}</oldVersion>
                            <newVersion>${project.version}</newVersion>
                            <parameter>
                                <onlyModified>true</onlyModified>
                            </parameter>
                            <breakBuildOnModifications>true</breakBuildOnModifications>
                        </configuration>
                        <executions>
                            <execution>
                                <goals><goal>cmp</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>